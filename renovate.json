{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "enabledManagers": [
    "github-actions"
  ],
  "pinDigests": true,
  "semanticCommits": "disabled",
  "schedule": [
    "before 6am on monday"
  ],
  "packageRules": [
    {
      "matchManagers": [
        "github-actions"
      ],
      "groupName": "workflow actions"
    },
    {
      "description": "Runner images and Node versions are chosen deliberately, only actions are tracked",
      "matchDatasources": [
        "github-runners",
        "node-version"
      ],
      "enabled": false
    },
    {
      "description": "The Node version comes from a workflow variable and cannot be tracked",
      "matchDepNames": [
        "node"
      ],
      "enabled": false
    }
  ]
}
