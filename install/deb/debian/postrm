#!/bin/sh
# postrm script for {{package_sysname}}
# see: dh_installdeb(1)

set -e

case "$1" in
	purge)
		if [ -e /usr/share/debconf/confmodule ]; then
			. /usr/share/debconf/confmodule
			db_purge
		fi
		rm -rf /etc/{{package_sysname}}/{{product}}
		rm -rf /var/www/{{package_sysname}}/{{product}}
		rm -rf /etc/{{package_sysname}}/{{legacy_product}}
		rm -rf /var/www/{{legacy_product}}
	;;

	remove|upgrade|failed-upgrade|abort-install|abort-upgrade|disappear)
	;;

	*)
		echo "{{package_sysname}} postrm called with unknown argument \`$1'" >&2
		exit 1
		;;
esac

# dh_installdeb will replace this with shell code automatically
# generated by other debhelper scripts.

#DEBHELPER#

# Drop the failed state left by stopping the services, otherwise it outlives the removed unit files
case "$1" in
	remove|purge)
		systemctl reset-failed "{{product}}-*.service" "{{legacy_product}}-*.service" >/dev/null 2>&1 || true
	;;
esac

exit 0
