Template: {{package_name}}/host
Type: string
Description: Apps host address:

Template: {{package_name}}/port
Type: string
Description: Apps port number:

Template: {{package_name}}/db-host
Type: string
Description: Database host address:

Template: {{package_name}}/db-port
Type: string
Description: Database port number:

Template: {{package_name}}/db-user
Type: string
Description: Database username:

Template: {{package_name}}/db-pwd
Type: password
Description: Database user password:

Template: {{package_name}}/db-name
Type: string
Description: Database name:

Template: {{package_name}}/ds-url
Type: string
Description: External Docs server URL (e.g., http://docs.example.com:8083):

Template: {{package_name}}/elasticsearch-scheme
Type: select
Choices: http, https
Description: OpenSearch protocol:

Template: {{package_name}}/elasticsearch-host
Type: string
Description: OpenSearch host address:

Template: {{package_name}}/elasticsearch-port
Type: string
Description: OpenSearch port number:

Template: {{package_name}}/redis-host
Type: string
Description: Redis host address:

Template: {{package_name}}/redis-port
Type: string
Description: Redis port number:

Template: {{package_name}}/redis-username
Type: string
Description: Redis username (optional):

Template: {{package_name}}/redis-password
Type: password
Description: Redis password (optional):

Template: {{package_name}}/redis-db
Type: string
Description: Redis database index:

Template: {{package_name}}/rabbitmq-protocol
Type: select
Choices: amqp, amqps
Description: RabbitMQ protocol:

Template: {{package_name}}/rabbitmq-host
Type: string
Description: RabbitMQ host address:

Template: {{package_name}}/rabbitmq-port
Type: string
Description: RabbitMQ port number:

Template: {{package_name}}/rabbitmq-user
Type: string
Description: RabbitMQ username:

Template: {{package_name}}/rabbitmq-password
Type: string
Description: RabbitMQ user password:

Template: {{package_name}}/machinekey
Type: string
Description: Machine key for encryption:

Template: {{package_name}}/jwt-header
Type: string
Description: JWT header name:

Template: {{package_name}}/jwt-secret
Type: string
Description: JWT secret key:
