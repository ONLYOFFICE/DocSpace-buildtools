# Ignoring node_modules errors due to lack of ability to influence them
addFilter(r'node_modules')

# The bundled Node.js CLI entrypoint uses the standard `#!/usr/bin/env node` shebang; hardcoding an absolute interpreter path would break the upstream npm packaging convention
addFilter(r'E: env-script-interpreter')

# Packages use a non-standard user and group for our project directories, but the user and group are created in %pre common
addFilter(r' W: non-standard-(uid|gid)')

# This is necessary to ensure that all child packages are updated correctly
addFilter(r'W: requires-on-release')

# These are internal backend microservices; there is no user-facing README/doc to ship beyond the %license files already included
addFilter(r'W: no-documentation')

# Needed build/runtime artifacts that happen to be dotfiles: Next.js .next build dirs, client i18n .constants/.meta locale metadata, and the .private secrets dir
addFilter(r'W: hidden-file-or-dir')

# The document-formats directory is restricted to the onlyoffice group only, consistent with the 640 config files inside it
addFilter(r'E: non-standard-dir-perm')

# This is implemented for easier updating of the config, in case of adding new data or correcting errors.
addFilter(r'W: conffile-without-noreplace-flag')

# Third-party native libraries bundled via .NET self-contained publish (librdkafka, libgrpc_csharp_ext, etc.) live under our own service directories instead of standard system library paths; we can't alter RPATH/RUNPATH in vendored binaries if a future upstream build sets one
addFilter(r'E: binary-or-shlib-defines-rpath')

# The directory is used to store systemd files. rpmlint 2.4.0 (what CI actually installs via unpinned pip) does not exempt /usr/lib/systemd from only-non-binary-in-usr-lib in its default UsrLibBinaryException config; that exemption was only added in a later rpmlint version
addFilter(r'W: only-non-binary-in-usr-lib')

# Third-party vendored libraries (librdkafka.so, libgrpc_csharp_ext*.so) call the legacy gethostbyname family for DNS resolution; this check still exists in rpmlint 2.4.0 (what CI actually installs) even though a later rpmlint version we tested against dropped it
addFilter(r'W: binary-or-shlib-calls-gethostbyname')

# rpmlint infers a spurious "locales-<subpackage>" dependency from bundled translation files; no such package exists or should exist
addFilter(r'E: no-dependency-on locales-\S+')

# apps-configuration and apps-ssl-setup have a permission of 744, so that users do not have the opportunity to run the scripts
addFilter(r'non-standard-executable-perm')

# There is no manual page for apps-configuration or apps-ssl-setup
addFilter(r'W: no-manual-page-for-binary')

# We use this to protect sensitive information (ie passwords) in the config file
addFilter(r'non-readable')

# aspell false positives on correctly spelled technical words missing from its dictionary; scoped to the specific known words so a real future typo still gets reported
addFilter(r"E: spelling-error \('(vectorizes|configs|integrations)'")

# rpmlint's known-license list does not include the SPDX identifiers used for our dual license; no accepted spelling exists for this AGPL-3.0-only AND CC-BY-SA-4.0 combination
addFilter(r'W: invalid-license (AGPL-3.0-only|CC-BY-SA-4.0)')

# The use of the /var/www directory is caused by its past history as the default document root
addFilter(r'W: non-standard-dir-in-var www')

# Identical files are an expected artifact of the upstream build tooling: translation JSON identical across close locale variants (e.g. pt vs pt-BR), and Next.js/.NET publish output duplicating identical build artifacts
addFilter(r'files-duplicate')

# Building a cross-platform project, so those files are arch-independent
addFilter(r'arch-independent-package-contains-binary-or-object')

# Necessary to resolve a config conflict (%pre proxy) and to clean up the fixed, build-time-defined %{buildpath} on full removal (%postun)
addFilter(r'dangerous-command-in-%(pre|postun)')

# Log rotation is handled by nlog
addFilter(r'log-files-without-logrotate')

# The JAR index (META-INF/INDEX.LIST) is ignored at run-time since JDK 18
addFilter(r'jar-not-indexed')
