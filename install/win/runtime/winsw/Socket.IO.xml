<service>
	<id>Apps.Socket.IO</id>
	<name>ONLYOFFICE Apps Socket.IO</name>
	<description>ONLYOFFICE Apps Socket.IO</description>
	<priority>Normal</priority>
	<startmode>Automatic</startmode>
	<autoRefresh>false</autoRefresh>
	<onfailure action="restart" delay="10 sec"/>
	<logpath>{APPDIR}Logs</logpath>
	<env name="logPath" value="{APPDIR}Logs"/>
	<env name="API_HOST" value="{API_HOST}"/>
	<executable>node</executable>
	<arguments>&quot;{APPDIR}services\ASC.Socket.IO\service\server.js&quot; --app.hostname=127.0.0.1</arguments>
	<log mode="roll-by-size">
  		<sizeThreshold>10240</sizeThreshold>
  		<keepFiles>8</keepFiles>
	</log>
</service>