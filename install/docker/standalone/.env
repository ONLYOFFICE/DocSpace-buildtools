# docker-compose tags #
    REGISTRY=""
    GIT_BRANCH=""
    PRODUCT=onlyoffice
    REPO=${PRODUCT}
    INSTALLATION_TYPE="community"
    CONFIG_OVERRIDE=""
    STATUS=""
    DOCKER_IMAGE_PREFIX=${STATUS}apps
    CONTAINER_PREFIX=${PRODUCT}-
    SERVICE_PORT=5050
    VOLUMES_DIR=""
    APP_DOTNET_ENV=""
    EXTERNAL_PORT="80"
    EXTERNAL_PORT_HTTPS="443"
    NODE_OPTIONS="--max_old_space_size=4096"
    UID="104"
    GID="107"
    NETWORK_NAME=${PRODUCT}
    EXTRA_HOSTS=""
# Bundled dependencies to run; install-Docker.sh drops the ones replaced by an external host.
    COMPOSE_PROFILES=mysql,opensearch,docs

# images version #
    DOCKER_TAG=latest
    MYSQL_VERSION=8.4
    PROXY_VERSION=1.30
    REDIS_VERSION=7
    RABBITMQ_VERSION=3
    ELK_VERSION=3.5.0
    FLUENT_BIT_VERSION=5.1.5
    DASHBOARDS_VERSION=3.5.0
    DOCUMENT_SERVER_VERSION=latest
    MIGRATION_TAG=${DOCKER_TAG}

# images name #
    MYSQL_IMAGE=mysql:${MYSQL_VERSION}
    ELK_IMAGE_NAME=${REPO}/opensearch:${ELK_VERSION}
    DOCUMENT_SERVER_IMAGE_NAME=${REPO}/documentserver:${DOCUMENT_SERVER_VERSION}

# services host #
   APPS_PREVIEW_NAME=${CONTAINER_PREFIX}apps
   PROXY_NAME=${CONTAINER_PREFIX}proxy
   MIGRATION_RUNNER_NAME=${CONTAINER_PREFIX}migration-runner
   MYSQL_CONTAINER_NAME=${CONTAINER_PREFIX}mysql-server
   REDIS_CONTAINER_NAME=${CONTAINER_PREFIX}redis
   RABBIT_CONTAINER_NAME=${CONTAINER_PREFIX}rabbitmq
   DOCUMENT_CONTAINER_NAME=${CONTAINER_PREFIX}document-server

# opensearch stack #
    ELK_CONTAINER_NAME=${CONTAINER_PREFIX}opensearch
    ELK_SCHEME=http
    ELK_HOST=""
    ELK_PORT=9200
    DASHBOARDS_USERNAME=onlyoffice
    DASHBOARDS_PASSWORD=
    FLUENT_BIT_CONTAINER_NAME=${CONTAINER_PREFIX}fluent-bit

# app service environment #
    ENV_EXTENSION=none
    APP_CORE_BASE_DOMAIN=localhost
    APP_URL_PORTAL="http://${APPS_PREVIEW_NAME}:8092"
    OAUTH_REDIRECT_URL="https://service.onlyoffice.com/oauth2.aspx"
    WRONG_PORTAL_NAME_URL=""
    LOG_LEVEL="Warning"
    DEBUG_INFO="false"

    APP_KNOWN_PROXIES=""
    APP_KNOWN_NETWORKS=""
    APP_CORE_SERVER_ROOT=""
# Left empty, the container generates and persists its own; install-Docker.sh always sets both so they survive a deployment-mode switch.
    APP_CORE_MACHINEKEY=""
    IDENTITY_ENCRYPTION_SECRET=""

    CERTIFICATE_PATH=""
    CERTIFICATE_KEY_PATH=""
    DHPARAM_PATH=""
    LETSENCRYPT_CONFIG_DIR=./config/nginx/ssl/letsencrypt

# docs #
    DOCUMENT_SERVER_URL_EXTERNAL=""
    DOCUMENT_SERVER_JWT_SECRET=
    DOCUMENT_SERVER_JWT_HEADER=AuthorizationJwt
    DOCUMENT_SERVER_URL_PUBLIC=/ds-vpath/

# document agent #
    # The external document agent (A2A server) the AI chat delegates document
    # creation and editing to; empty leaves the chat without that tool.
    DOCUMENT_AGENT_URL=
    DOCUMENT_AGENT_TOKEN=

# plugin agent #
    # The sandbox gateway the AI chat builds a portal plugin in; an empty URL or
    # token leaves the chat without the plugin tools. The token is the one of the
    # gateway profile that gives Node sandboxes.
    PLUGIN_AGENT_SANDBOX_URL=
    PLUGIN_AGENT_SANDBOX_TOKEN=
    # Empty keeps the default of the service: 1800 (60 - 7200), 150 (1 - 10000),
    # 2 (1 - 16) and 600 (60 - 3600).
    PLUGIN_AGENT_TASK_TIMEOUT_SECONDS=
    PLUGIN_AGENT_MAX_TOOL_CALLS=
    PLUGIN_AGENT_MAX_CONCURRENT_TASKS=
    PLUGIN_AGENT_SANDBOX_TTL_SECONDS=
    # Where a sandbox reaches the AI chat service, for its package registry
    # route; empty leaves the route off and npm to what the sandbox gives it.
    PLUGIN_AGENT_SERVICE_URL=
    # Empty keeps https://registry.npmjs.org, a directory in the temp dir and
    # 2048 (64 - 65536).
    PLUGIN_AGENT_REGISTRY_URL=
    PLUGIN_AGENT_CACHE_DIR=
    PLUGIN_AGENT_CACHE_MAX_MB=

# chat sandbox #
    # The sandbox gateway the AI chat runs commands and keeps files in; an empty
    # URL or token leaves the chat without the sandbox tools. The token is the
    # one of a gateway profile without egress.
    CHAT_SANDBOX_URL=
    CHAT_SANDBOX_TOKEN=
    # Empty keeps the default of the service: 900 (60 - 3000).
    CHAT_SANDBOX_IDLE_TTL_SECONDS=

# redis # 
    REDIS_PORT=6379
    REDIS_USER_NAME=""
    REDIS_PASSWORD=""
    REDIS_DB="0"

# rabbitmq # 
    RABBIT_PROTOCOL="amqp"
    RABBIT_PORT=5672
    RABBIT_VIRTUAL_HOST=/
    RABBIT_USER_NAME=guest
    RABBIT_PASSWORD=

# mysql # 
    MYSQL_HOST=""
    MYSQL_PORT=3306
    MYSQL_SSL_MODE=none
    MYSQL_ROOT_PASSWORD=
    MYSQL_DATABASE=onlyoffice_apps
    MYSQL_USER=${PRODUCT}_user
    MYSQL_PASSWORD=
    DATABASE_MIGRATION=false
    MIGRATION_TYPE="STANDALONE"
